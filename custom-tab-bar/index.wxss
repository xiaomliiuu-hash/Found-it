.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  background: var(--card, #FBF6E6);
  border-radius: 999rpx;
  padding: 10rpx;
  box-shadow: var(--shadow-float, 0 8rpx 24rpx rgba(120, 110, 80, 0.10));
  z-index: 1000;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  transition: background 0.2s ease;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-sub, #8E8B7E);
  margin-left: 8rpx;
  display: none;
}

.tab-item.active {
  background: var(--primary, #54684F);
}

.tab-item.active .tab-icon {
  filter: brightness(0) invert(1);
}

.tab-item.active .tab-text {
  display: inline;
  color: #ffffff;
  font-weight: 600;
}
