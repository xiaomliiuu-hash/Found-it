.page {
  padding: 24rpx 24rpx 80rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0 24rpx;
}

.avatar-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  box-shadow: var(--shadow-card, 0 6rpx 20rpx rgba(255, 122, 69, 0.12));
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8A8A90;
}

.card {
  background: #fff;
  border-radius: var(--radius-card, 32rpx);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card, 0 6rpx 20rpx rgba(255, 122, 69, 0.12));
}

.card-title {
  font-size: 26rpx;
  color: #8A8A90;
  margin-bottom: 20rpx;
}

.avatar-grid {
  display: flex;
  flex-wrap: wrap;
}

.avatar-item {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin: 0 20rpx 20rpx 0;
  padding: 6rpx;
  box-sizing: border-box;
}

.avatar-opt {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-active {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 6rpx var(--primary, #FF7A45);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F2F2F4;
}

.row:last-child {
  border-bottom: none;
}

.row-name {
  font-size: 28rpx;
}

.arrow {
  color: #C8C8CE;
  font-size: 32rpx;
}

.name-box {
  display: flex;
  align-items: center;
  background: #F7F7F9;
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.name-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.name-ph {
  color: #B0B0B6;
}

.name-count {
  font-size: 24rpx;
  color: #B0B0B6;
}

.save-btn {
  background: var(--primary-grad, linear-gradient(135deg, #FFB199, #FF7A45));
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 40rpx;
  box-shadow: var(--shadow-float, 0 10rpx 28rpx rgba(255, 122, 69, 0.12));
}
