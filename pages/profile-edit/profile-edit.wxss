.page {
  padding: 24rpx 24rpx 80rpx;
}

.avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx 0 24rpx;
}

.avatar-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--card, #FBF6E6);
  box-shadow: var(--shadow-card, 0 2rpx 8rpx rgba(120, 110, 80, 0.06));
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub, #8E8B7E);
}

.card {
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card, 28rpx);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card, 0 2rpx 8rpx rgba(120, 110, 80, 0.06));
}

.card-title {
  font-size: 26rpx;
  color: var(--text-sub, #8E8B7E);
  margin-bottom: 20rpx;
}

.avatar-grid {
  display: flex;
  flex-wrap: wrap;
}

.avatar-item {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin: 0 20rpx 20rpx 0;
  padding: 6rpx;
  box-sizing: border-box;
}

.avatar-opt {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-active {
  box-shadow: 0 0 0 3rpx var(--card, #FBF6E6), 0 0 0 6rpx var(--primary, #54684F);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
}

.row:last-child {
  border-bottom: none;
}

.row-name {
  font-size: 28rpx;
}

.arrow {
  color: var(--text-faint, #B4B0A4);
  font-size: 32rpx;
}

.name-box {
  display: flex;
  align-items: center;
  background: var(--chip, rgba(140, 130, 100, 0.08));
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.name-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.name-ph {
  color: var(--text-faint, #B4B0A4);
}

.name-count {
  font-size: 24rpx;
  color: var(--text-faint, #B4B0A4);
}

.save-btn {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 40rpx;
  box-shadow: var(--shadow-float, 0 8rpx 24rpx rgba(120, 110, 80, 0.10));
}
