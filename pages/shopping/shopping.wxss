.page {
  padding: 24rpx;
}

.head {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.card {
  display: flex;
  align-items: center;
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card, 28rpx);
  padding: 20rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: var(--shadow-card, 0 2rpx 8rpx rgba(120, 110, 80, 0.06));
}

.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}

.check.checked {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  border-color: var(--primary, #54684F);
}

.icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm, 16rpx);
  background: var(--primary-tint, #D9E2D6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-sub, #8E8B7E);
}

.badge {
  font-size: 22rpx;
  color: #fff;
  background: var(--sem-danger, #CF8B86);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.badge.warn {
  background: var(--sem-warn, #C99A5B);
}
