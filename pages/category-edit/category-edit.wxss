.page {
  padding: 24rpx 24rpx 160rpx;
}

.card {
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card);
  padding: 8rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
}

.label {
  width: 120rpx;
  color: var(--text-sub, #8E8B7E);
  font-size: 28rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.preview {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}

.preview-icon {
  font-size: 32rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
}

.emoji {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 16rpx;
  margin: 0 12rpx 12rpx 0;
}

.emoji.active {
  background: var(--primary-tint);
  box-shadow: 0 0 0 2rpx var(--primary, #54684F);
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
}

.color {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin: 0 20rpx 20rpx 0;
}

.color.active {
  box-shadow: 0 0 0 3rpx var(--card, #FBF6E6), 0 0 0 6rpx var(--primary, #54684F);
}

.footer-space {
  height: 140rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 24rpx;
  background: var(--card, #FBF6E6);
  box-shadow: 0 -6rpx 24rpx rgba(120, 110, 80, 0.08);
}

.btn-del {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  color: var(--sem-danger, #CF8B86);
  background: var(--sem-danger-bg, #F6E9E7);
  border-radius: 999rpx;
  margin-right: 20rpx;
  font-size: 30rpx;
}

.btn-primary {
  flex: 2;
  text-align: center;
  padding: 24rpx;
  background: var(--primary-grad);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-float);
}
