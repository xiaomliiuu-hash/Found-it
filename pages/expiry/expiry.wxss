.page {
  padding: 24rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-title, #3C3A33);
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary, #54684F);
  margin-right: 10rpx;
  flex-shrink: 0;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-head .section-title {
  margin-bottom: 0;
}

.archive-btn {
  font-size: 24rpx;
  color: var(--primary, #54684F);
  background: var(--primary-tint, #D9E2D6);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
