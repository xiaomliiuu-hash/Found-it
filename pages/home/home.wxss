.page {
  padding: 20rpx 24rpx 160rpx;
}

.search-bar {
  margin-bottom: 16rpx;
}

.search-input {
  background: var(--card, #FBF6E6);
  border-radius: 999rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 空间切换 */
.space-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.space-row {
  display: inline-flex;
  align-items: center;
}

.space-chip {
  display: inline-flex;
  align-items: center;
  background: var(--card, #FBF6E6);
  color: var(--text-body, #5C5A50);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
  font-weight: 500;
}

.space-active {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
  font-weight: 600;
}

.space-add {
  background: var(--primary-tint, #D9E2D6);
  color: var(--primary, #54684F);
}

/* 搜索历史 */
.history {
  background: var(--card, #FBF6E6);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-title {
  font-size: 24rpx;
  color: var(--text-sub, #8E8B7E);
}

.history-clear {
  font-size: 24rpx;
  color: var(--primary, #54684F);
}

.history-chips {
  display: flex;
  flex-wrap: wrap;
}

.history-chip {
  background: rgba(140, 130, 100, 0.10);
  color: var(--text-body, #5C5A50);
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 新手引导遮罩 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(60, 58, 51, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.guide {
  background: var(--card, #FBF6E6);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  text-align: center;
}

.guide-logo {
  font-size: 88rpx;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-title, #3C3A33);
  margin-top: 16rpx;
}

.guide-sub {
  font-size: 26rpx;
  color: var(--text-sub, #8E8B7E);
  margin-top: 12rpx;
  line-height: 1.5;
}

.guide-steps {
  margin: 36rpx 0;
  text-align: left;
}

.guide-step {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.gs-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.gs-text {
  font-size: 28rpx;
  color: var(--text-title, #3C3A33);
}

.guide-btn {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-float, 0 10rpx 28rpx rgba(120, 110, 80, 0.12));
}

/* 数据仪表盘 */
.dash {
  background: linear-gradient(135deg, var(--card, #FBF6E6), var(--primary-tint, #D9E2D6));
  border-radius: var(--radius-card, 28rpx);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.dash-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.dash-sub {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-title, #3C3A33);
}

.dash-value {
  font-size: 24rpx;
  color: var(--primary, #54684F);
  font-weight: 600;
}

.dash-stats {
  display: flex;
  border-top: 1rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
  padding-top: 20rpx;
  margin-bottom: 16rpx;
}

.dstat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dstat-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--primary, #54684F);
}

.dstat-label {
  font-size: 22rpx;
  color: var(--text-sub, #8E8B7E);
  margin-top: 4rpx;
}

.d-warn {
  color: var(--sem-warn, #C99A5B);
}

.d-danger {
  color: var(--sem-danger, #CF8B86);
}

.dash-bars {
  border-top: 1rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
  padding-top: 16rpx;
}

.dbar {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.dbar-icon {
  width: 40rpx;
  font-size: 24rpx;
}

.dbar-name {
  width: 110rpx;
  font-size: 24rpx;
  color: var(--text-body, #5C5A50);
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dbar-track {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(140, 130, 100, 0.12);
  margin: 0 16rpx;
  overflow: hidden;
}

.dbar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.dbar-pct {
  width: 64rpx;
  font-size: 22rpx;
  color: var(--text-sub, #8E8B7E);
  text-align: right;
}

/* 视图切换 */
.seg {
  display: flex;
  background: rgba(140, 130, 100, 0.12);
  border-radius: 999rpx;
  padding: 4rpx;
  margin-bottom: 16rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--text-body, #5C5A50);
  border-radius: 999rpx;
}

.seg-active {
  background: var(--card, #FBF6E6);
  color: var(--text-title, #3C3A33);
  font-weight: 600;
}

.reminder {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
  border-radius: var(--radius-sm, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
  position: relative;
}

.rem-line {
  line-height: 1.5;
}

.arrow {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.filter-row {
  display: inline-flex;
}

.chip {
  display: inline-block;
  background: var(--card, #FBF6E6);
  color: var(--text-body, #5C5A50);
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
}

.chip-active {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
}

.room-group {
  margin-bottom: 8rpx;
}

.room-head {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-title, #3C3A33);
  margin: 12rpx 4rpx 16rpx;
}

.empty-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.eh-bubble {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--primary-tint, #D9E2D6);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card, 0 4rpx 16rpx rgba(120, 110, 80, 0.08));
}

.eh-icon {
  font-size: 96rpx;
  line-height: 1;
}

.eh-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-title, #3C3A33);
  margin-bottom: 12rpx;
}

.eh-sub {
  font-size: 26rpx;
  color: var(--text-sub, #8E8B7E);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  white-space: pre-line;
}

.eh-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.eh-primary {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-float, 0 10rpx 28rpx rgba(120, 110, 80, 0.12));
}

.eh-ghost {
  background: var(--primary-tint, #D9E2D6);
  color: var(--primary, #54684F);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(190rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float, 0 10rpx 28rpx rgba(120, 110, 80, 0.12));
}

/* 麦克风 FAB */
.fab-voice {
  position: fixed;
  right: 40rpx;
  bottom: calc(330rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--card, #FBF6E6);
  color: var(--primary, #54684F);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float, 0 10rpx 28rpx rgba(120, 110, 80, 0.12));
  z-index: 900;
}

/* 语音录入浮层 */
.voice-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(60, 58, 51, 0.45);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.voice-panel {
  width: 100%;
  background: var(--card, #FBF6E6);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.voice-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-title, #3C3A33);
}

.voice-text {
  width: 100%;
  min-height: 120rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(140, 130, 100, 0.08);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-title, #3C3A33);
  line-height: 1.6;
  box-sizing: border-box;
}

.voice-text-hint {
  color: var(--text-sub, #8E8B7E);
}

.voice-btn {
  margin-top: 40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--primary-tint, #D9E2D6);
  color: var(--primary, #54684F);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.voice-btn-recording {
  background: var(--primary-grad, linear-gradient(135deg, #A7BBA5, #54684F));
  color: #fff;
  transform: scale(1.12);
  box-shadow: 0 0 0 12rpx var(--primary-glow, rgba(84, 104, 79, 0.12));
}

.voice-btn-icon {
  font-size: 64rpx;
  line-height: 1;
}

.voice-btn-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.voice-cancel {
  margin-top: 40rpx;
  padding: 12rpx 40rpx;
  font-size: 28rpx;
  color: var(--text-sub, #8E8B7E);
}
