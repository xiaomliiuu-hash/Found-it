.photos {
  width: 100%;
  height: 500rpx;
  background: var(--primary-tint, #D9E2D6);
}

.photo {
  width: 100%;
  height: 500rpx;
}

.photo-placeholder {
  width: 100%;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
  background: var(--primary-tint);
}

.content {
  padding: 24rpx;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  flex: 1;
}

.badge {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  color: #fff;
}

.badge.expired {
  background: var(--sem-danger, #CF8B86);
}

.badge.soon {
  background: var(--sem-warn, #C99A5B);
}

.card {
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card);
  padding: 8rpx 24rpx;
  box-shadow: var(--shadow-card);
}

.row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
}

.row:last-child {
  border-bottom: none;
}

.k {
  width: 120rpx;
  color: var(--text-sub, #8E8B7E);
  font-size: 28rpx;
  flex-shrink: 0;
}

.v {
  flex: 1;
  font-size: 28rpx;
}

.hint {
  color: var(--text-sub, #8E8B7E);
  font-size: 24rpx;
}

.borrowed {
  color: var(--sem-info, #7E96B5);
}

.note {
  white-space: pre-wrap;
}

.tag {
  display: inline-block;
  background: var(--chip, rgba(140, 130, 100, 0.08));
  color: var(--text-body, #5C5A50);
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.footer-space {
  height: 220rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card, #FBF6E6);
  box-shadow: 0 -6rpx 24rpx rgba(120, 110, 80, 0.08);
}

.action-grid {
  display: flex;
}

.action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--primary-tint);
  font-size: 44rpx;
  display: inline-block;
}

.action-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-title, #3C3A33);
}

.footer-links {
  display: flex;
  justify-content: center;
  border-top: 1rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
  padding-top: 12rpx;
}

.link {
  margin: 0 32rpx;
  font-size: 26rpx;
  color: var(--text-sub, #8E8B7E);
}

.archived-hint {
  margin-right: 12rpx;
  font-size: 22rpx;
  color: var(--text-sub, #8E8B7E);
  background: var(--chip, rgba(140, 130, 100, 0.08));
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(60, 58, 51, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--surface, #FFFDF6);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.sheet-label {
  font-size: 26rpx;
  color: var(--text-sub, #8E8B7E);
  margin: 16rpx 0 12rpx;
}

.sheet-chips {
  display: flex;
  flex-wrap: wrap;
}

.sheet-chip {
  background: var(--chip, rgba(140, 130, 100, 0.08));
  color: var(--text-body, #5C5A50);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  margin: 0 14rpx 14rpx 0;
}

.sheet-chip-active {
  background: var(--primary-grad);
  color: #fff;
}

.sheet-input {
  background: var(--chip, rgba(140, 130, 100, 0.08));
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.sheet-btn {
  margin-top: 32rpx;
  text-align: center;
  padding: 24rpx;
  background: var(--primary-grad);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: var(--shadow-float);
}
