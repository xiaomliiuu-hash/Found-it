<view class="page" style="{{themeStyle}}">
  <!-- 常用模板 -->
  <view class="section card" wx:if="{{!isEdit}}">
    <view class="section-title">常用模板 · 点一下快速带入</view>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="tpl-scroll">
      <view class="tpl-row">
        <view class="tpl-chip" wx:for="{{templates}}" wx:key="name" data-name="{{item.name}}" data-category="{{item.categoryId}}" data-unit="{{item.unit}}" data-shelf="{{item.shelfDays || ''}}" bindtap="onTemplate">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 照片与备注 -->
  <view class="section card">
    <view class="section-title">照片与备注</view>
    <view class="photo-grid">
      <view class="photo-item" wx:for="{{form.photos}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto" />
        <view class="photo-del" data-url="{{item}}" catchtap="removePhotoTap">×</view>
      </view>
      <view class="photo-add" bindtap="choosePhoto" wx:if="{{form.photos.length < 9}}">
        <text class="plus">+</text>
        <text>拍照</text>
      </view>
    </view>
    <textarea class="textarea" placeholder="备注：规格、开封后冷藏、注意事项…" value="{{form.note}}" bindinput="onNote" />
  </view>

  <!-- 基本信息 -->
  <view class="section card">
    <view class="form-row">
      <text class="label">名称 *</text>
      <input class="input" placeholder="例如：感冒灵颗粒" value="{{form.name}}" bindinput="onName" />
    </view>
    <view class="form-row">
      <text class="label">数量</text>
      <input class="input" type="number" placeholder="例如：2" value="{{form.quantity}}" bindinput="onQuantity" />
    </view>
    <view class="form-row">
      <text class="label">单位</text>
      <input class="input" placeholder="例如：盒" value="{{form.unit}}" bindinput="onUnit" />
    </view>
    <view class="chips">
      <view class="chip {{form.unit === item ? 'chip-active' : ''}}" wx:for="{{units}}" wx:key="*this" data-unit="{{item}}" bindtap="onUnitChip">{{item}}</view>
    </view>
    <view class="form-row">
      <text class="label">房间</text>
      <input class="input" placeholder="例如：客厅" value="{{form.room}}" bindinput="onRoom" />
    </view>
    <view class="chips">
      <view class="chip {{form.room === item ? 'chip-active' : ''}}" wx:for="{{rooms}}" wx:key="*this" data-room="{{item}}" bindtap="onRoomChip">{{item}}</view>
    </view>
    <view class="form-row">
      <text class="label">具体位置</text>
      <input class="input" placeholder="例如：电视柜第二个抽屉" value="{{form.place}}" bindinput="onPlace" />
    </view>
  </view>

  <!-- 所属空间 -->
  <view class="section card">
    <view class="section-title">所属空间</view>
    <picker mode="selector" range="{{spaces}}" range-key="name" value="{{spaceIndex}}" bindchange="onSpaceChange">
      <view class="form-row row-between">
        <text class="label">空间</text>
        <text class="value">{{spaces[spaceIndex].icon}} {{spaces[spaceIndex].name}} ›</text>
      </view>
    </picker>
  </view>

  <!-- 分类 -->
  <view class="section card">
    <view class="section-title-row">
      <text class="section-title">分类</text>
      <text class="cat-funnel" bindtap="openCategorySheet">🔽 筛选</text>
    </view>
    <view class="cat-current-row" bindtap="openCategorySheet">
      <block wx:for="{{categories}}" wx:key="id">
        <view wx:if="{{form.categoryId === item.id}}" class="cat-current">
          <text class="cat-current-icon">{{item.icon}}</text>
          <text class="cat-current-name">{{item.name}}</text>
          <text class="cat-arrow">▾</text>
        </view>
      </block>
      <view wx:if="{{!form.categoryId}}" class="cat-current">
        <text class="cat-current-name">选择分类</text>
        <text class="cat-arrow">▾</text>
      </view>
    </view>
  </view>

  <!-- 归属人 -->
  <view class="section card">
    <view class="section-title">归属人</view>
    <view class="chips">
      <view class="chip {{form.memberId === item.id ? 'chip-active' : ''}}" wx:for="{{members}}" wx:key="id" data-id="{{item.id}}" bindtap="onMember">{{item.name}}</view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="section card">
    <view class="section-title">标签</view>
    <view class="chips">
      <view class="chip chip-tag" wx:for="{{form.tags}}" wx:key="*this">{{item}} <text data-tag="{{item}}" catchtap="removeTag">×</text></view>
    </view>
    <view class="tag-add">
      <input class="input" placeholder="输入标签，如：常用、囤货" value="{{tagInput}}" bindinput="onTagInput" confirm-type="done" bindconfirm="addTag" />
      <view class="btn-mini" bindtap="addTag">添加</view>
    </view>
  </view>

  <!-- 保质期 -->
  <view class="section card">
    <view class="form-row row-between">
      <text class="label">保质期提醒</text>
      <switch checked="{{form.expiryEnabled}}" bindchange="onExpirySwitch" color="{{themeColor}}" />
    </view>
    <block wx:if="{{form.expiryEnabled}}">
      <picker mode="date" value="{{form.date}}" bindchange="onDate">
        <view class="form-row row-between">
          <text class="label">到期日期</text>
          <text class="value">{{form.date || '请选择'}}</text>
        </view>
      </picker>
      <picker mode="selector" range="{{alertOptions}}" value="{{alertIndex}}" bindchange="onAlert">
        <view class="form-row row-between">
          <text class="label">提前提醒</text>
          <text class="value">提前 {{alertOptions[alertIndex]}} 天</text>
        </view>
      </picker>
    </block>

    <!-- 开封后保质期 -->
    <view class="form-row row-between sub-gap">
      <text class="label">开封日期</text>
      <picker mode="date" value="{{form.openedAt}}" bindchange="onOpenedAt">
        <view class="pick-value">{{form.openedAt || '选择日期'}}</view>
      </picker>
    </view>
    <view class="form-row row-between">
      <text class="label">开封后保质</text>
      <view class="shelf-input-wrap">
        <input class="input num" type="number" placeholder="如 3" value="{{form.shelfDays}}" bindinput="onShelfDays" />
        <text class="unit-suffix">天</text>
      </view>
    </view>

    <view class="remaining {{remainingClass}}" wx:if="{{remainingText}}">
      {{remainingText}}{{openedHint ? ' · 按开封后保质期' : ''}}
    </view>
  </view>

  <!-- 购买信息 -->
  <view class="section card">
    <view class="section-title">购买信息（选填）</view>
    <picker mode="date" value="{{form.purchaseDate}}" bindchange="onPurchaseDate">
      <view class="form-row row-between">
        <text class="label">购买日期</text>
        <text class="value">{{form.purchaseDate || '请选择'}}</text>
      </view>
    </picker>
    <view class="form-row">
      <text class="label">购买渠道</text>
      <input class="input" placeholder="如：京东、超市" value="{{form.purchaseStore}}" bindinput="onPurchaseStore" />
    </view>
    <view class="form-row">
      <text class="label">价格</text>
      <input class="input" type="digit" placeholder="如：29.9" value="{{form.purchasePrice}}" bindinput="onPurchasePrice" />
    </view>
  </view>

  <!-- 库存与借出 -->
  <view class="section card">
    <view class="form-row">
      <text class="label">低库存阈值</text>
      <input class="input" type="number" placeholder="低于 N 件提醒我" value="{{form.lowStockThreshold}}" bindinput="onLowStock" />
    </view>
    <view class="form-row row-between">
      <text class="label">借出中</text>
      <switch checked="{{form.borrowedEnabled}}" bindchange="onBorrowedSwitch" color="{{themeColor}}" />
    </view>
    <view class="form-row" wx:if="{{form.borrowedEnabled}}">
      <text class="label">借给谁</text>
      <input class="input" placeholder="如：借给同事小李" value="{{form.borrowedTo}}" bindinput="onBorrowedTo" />
    </view>
  </view>

  <view class="footer-space"></view>
  <view class="footer-bar">
    <view class="btn-ghost" wx:if="{{!isEdit}}" bindtap="saveAndContinue">保存并继续添加</view>
    <view class="btn-primary" bindtap="save">保存</view>
  </view>

  <!-- 分类筛选浮层 -->
  <view class="mask" wx:if="{{showCategoryPicker}}" catchtap="closeCategorySheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">选择分类</view>
      <view class="cat-grid">
        <view class="cat-cell {{form.categoryId === item.id ? 'cat-cell-active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategoryPick">
          <text class="cat-cell-icon">{{item.icon}}</text>
          <text class="cat-cell-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
