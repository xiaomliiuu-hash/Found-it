.page {
  padding: 24rpx;
}

.head {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.card {
  display: flex;
  align-items: center;
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card);
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
}

.thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-tint);
  font-size: 44rpx;
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-sub, #8E8B7E);
}

.act {
  flex-shrink: 0;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.restore {
  color: var(--primary, #54684F);
  background: var(--primary-tint);
}

.del {
  color: var(--sem-danger, #CF8B86);
  background: var(--sem-danger-bg, #F6E9E7);
}

.empty-btn {
  margin-top: 8rpx;
  text-align: center;
  padding: 24rpx;
  color: var(--sem-danger, #CF8B86);
  background: var(--card, #FBF6E6);
  border-radius: 20rpx;
  font-size: 28rpx;
}
