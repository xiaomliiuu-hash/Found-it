.page {
  padding: 24rpx 24rpx 60rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card, 28rpx);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card, 0 2rpx 8rpx rgba(120, 110, 80, 0.06));
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--chip, rgba(140, 130, 100, 0.08));
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-title, #3C3A33);
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub, #8E8B7E);
}

.profile-arrow {
  color: var(--text-faint, #B4B0A4);
  font-size: 32rpx;
}

.stats {
  display: flex;
  margin-bottom: 8rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary, #54684F);
}

.label {
  font-size: 24rpx;
  color: var(--text-sub, #8E8B7E);
  margin-top: 6rpx;
}

.card {
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card, 28rpx);
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card, 0 2rpx 8rpx rgba(120, 110, 80, 0.06));
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 4rpx 16rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-divider, rgba(140, 130, 100, 0.18));
}

.row:last-child {
  border-bottom: none;
}

.row-between {
  justify-content: space-between;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.row-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.row-name {
  flex: 1;
  font-size: 28rpx;
}

.del {
  color: var(--sem-danger, #CF8B86);
  font-size: 26rpx;
}

.space-current {
  margin-right: 24rpx;
  font-size: 22rpx;
  color: var(--primary, #54684F);
  background: var(--primary-tint, #D9E2D6);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.add {
  color: var(--primary, #54684F);
}

.arrow {
  color: var(--text-faint, #B4B0A4);
  font-size: 32rpx;
}

.hint {
  color: var(--text-sub, #8E8B7E);
  font-size: 24rpx;
}

.room-wrap {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0 8rpx;
}

.room-chip {
  background: var(--chip, rgba(140, 130, 100, 0.08));
  color: var(--text-body, #5C5A50);
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  margin: 0 14rpx 14rpx 0;
  display: flex;
  align-items: center;
}

.room-del {
  margin-left: 10rpx;
  color: var(--text-faint, #B4B0A4);
  font-size: 28rpx;
}

.theme-row {
  display: flex;
  padding: 20rpx 0 8rpx;
}

.theme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.theme-swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.theme-item.active .theme-swatch {
  box-shadow: 0 0 0 3rpx var(--card, #FBF6E6), 0 0 0 6rpx var(--primary, #54684F);
}

.theme-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub, #8E8B7E);
}

.about {
  text-align: center;
  color: var(--text-faint, #B4B0A4);
  font-size: 24rpx;
  margin-top: 40rpx;
}
