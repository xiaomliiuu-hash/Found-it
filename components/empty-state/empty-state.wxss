.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.icon-bubble {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--primary-tint, #FFF3EE);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card, 0 6rpx 20rpx rgba(255, 122, 69, 0.12));
}

.icon {
  font-size: 96rpx;
  line-height: 1;
}

.text {
  margin-top: 32rpx;
  color: var(--text-2, #8A8A90);
  font-size: 28rpx;
}
