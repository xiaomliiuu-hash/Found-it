.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.icon-bubble {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--primary-tint, #D9E2D6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card, 0 2rpx 8rpx rgba(120, 110, 80, 0.06));
}

.icon {
  font-size: 96rpx;
  line-height: 1;
}

.text {
  margin-top: 32rpx;
  color: var(--text-2, #8E8B7E);
  font-size: 28rpx;
}
