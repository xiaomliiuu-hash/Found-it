.card {
  display: flex;
  align-items: center;
  background: var(--card, #FBF6E6);
  border-radius: var(--radius-card, 28rpx);
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: var(--shadow-card, 0 2rpx 8rpx rgba(120, 110, 80, 0.06));
}

.thumb-wrap {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm, 20rpx);
  background: var(--primary-tint, #D9E2D6);
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: baseline;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-title, #3C3A33);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qty {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub, #8E8B7E);
  flex-shrink: 0;
}

.loc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub, #8E8B7E);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-right: 8rpx;
}

.tag-borrowed {
  color: var(--sem-info, #7E96B5);
  background: var(--sem-info-bg, #E7ECF4);
}

.tag-lowstock {
  color: var(--sem-warn, #C99A5B);
  background: var(--sem-warn-bg, #F5EDE1);
}

.tag-usedup {
  color: var(--text-sub, #8E8B7E);
  background: rgba(140, 130, 100, 0.12);
}

.card.used-up {
  opacity: 0.55;
}

.card.used-up .thumb {
  filter: grayscale(1);
  opacity: 0.7;
}

.bar {
  margin-top: 12rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(140, 130, 100, 0.12);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.p-green { background: var(--sem-ok, #86A388); }
.p-orange { background: var(--sem-warn, #C99A5B); }
.p-red { background: var(--sem-danger, #CF8B86); }

.badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.badge.expired {
  background: var(--sem-danger, #CF8B86);
}

.badge.soon {
  background: var(--sem-warn, #C99A5B);
}
