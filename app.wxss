page {
  --primary: #FF7A45;
  background: #F5F6F8;
  color: #1A1A1A;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
input,
textarea,
image,
scroll-view,
swiper {
  box-sizing: border-box;
}
